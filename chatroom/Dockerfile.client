# 构建阶段
FROM golang:1.21-alpine AS builder

WORKDIR /app

# 先复制 go.mod 和 go.sum 以利用缓存
COPY go.mod go.sum ./
RUN go env -w GOPROXY=https://goproxy.cn,direct && go mod download

# 复制整个项目
COPY . .

# 编译客户端（客户端代码在 client 目录）
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /app/client ./client

# 运行阶段
FROM alpine:latest

WORKDIR /app

# 从构建阶段复制编译好的二进制文件
COPY --from=builder /app/client .

# 启动客户端
CMD ["./client", "chatroom-server:8080"]