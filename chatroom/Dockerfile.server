# 构建阶段
FROM golang:1.21-alpine AS builder

WORKDIR /app

# 先复制 go.mod 和 go.sum 以利用缓存
COPY go.mod go.sum ./
# 配置国内镜像源
RUN go env -w GOPROXY=https://goproxy.cn,direct && go mod download

# 复制整个项目
COPY . .

# 编译服务器（服务器代码在 server 目录）
# 静态编译：不依赖外部库
# 目标平台：Linux x86_64
# 输出路径：/app/server（容器内的路径）
# 编译包路径：./server（假设主包在 server 目录）
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /app/server ./server

# 运行阶段
FROM alpine:latest

WORKDIR /app

# 从构建阶段复制编译好的二进制文件
COPY --from=builder /app/server .

# 暴露端口
# 8080：聊天室主服务端口
# 8081：健康检查服务端口
EXPOSE 8080 8081

# 创建数据目录
RUN mkdir -p /app/data

# 启动服务器
CMD ["./server"]